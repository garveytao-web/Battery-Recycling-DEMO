<view class="page home-page">
  <view class="brand-lockup"><image src="/assets/logo-mark.png" mode="aspectFit"/><view><view class="brand-name">循电</view><view class="eyebrow">XUNDIAN</view></view></view>
  <swiper class="banner-swiper" indicator-dots="true" indicator-color="#ffffff77" indicator-active-color="#ffffff" autoplay="true" interval="4200" circular="true">
    <swiper-item wx:for="{{banners}}" wx:key="image"><view class="banner-slide" bindtap="estimate"><image class="banner-image" src="{{item.image}}" mode="aspectFill"/><view class="banner-copy"><view class="banner-eyebrow">{{item.eyebrow}}</view><view class="banner-title">{{item.title}}</view><view class="banner-subtitle">{{item.subtitle}}</view><view class="banner-cta">开始估价 →</view></view></view></swiper-item>
  </swiper>
  <view class="card quick-card">
    <view class="eyebrow">QUICK START</view><view class="title">动力电池回收参考估价</view>
    <view class="muted">公告车型检索，或按铭牌重量与总电量估价。</view>
    <button class="primary full space" bindtap="estimate">开始估价</button>
  </view>
  <view class="tile-grid">
    <view class="tile" bindtap="history"><view class="tile-glyph">◎</view><view class="subtitle">我的报告</view><view class="small muted">查看已保存的估价快照</view></view>
    <view class="tile warm" bindtap="market"><view class="tile-glyph">↔</view><view class="subtitle">供需大厅</view><view class="small muted">发布与接收私密意向</view></view>
  </view>
  <view class="card">
    <view class="title">两条估价路径</view>
    <view class="step-row"><text class="step-number">01</text><view><view class="subtitle">公告车型</view><view class="muted small">搜索公告型号，选择候选电池配置。</view></view></view>
    <view class="step-row"><text class="step-number">02</text><view><view class="subtitle">铭牌参数</view><view class="muted small">冷门或停产车型，填写化学体系、外形、总重量和总电量。</view></view></view>
  </view>
  <view class="bottom-note" bindtap="privacy">隐私说明与数据用途</view>
</view>
