<view class="page">
  <view class="page-heading">
    <view class="eyebrow">BATTERY VALUATION</view><view class="title">电池回收估价</view>
    <view class="muted">重量是主估值，电量用于交叉校验。</view>
  </view>
  <view class="mode-switch">
    <view class="mode-button {{mode === 'vehicle' ? 'active' : ''}}" data-mode="vehicle" bindtap="switchMode">公告车型估价</view>
    <view class="mode-button {{mode === 'manual' ? 'active' : ''}}" data-mode="manual" bindtap="switchMode">铭牌参数估价</view>
  </view>
  <view wx:if="{{mode === 'vehicle'}}" class="card">
    <view class="subtitle">输入公告车型</view><view class="muted small">支持公告型号、常见车型名或生产企业关键词检索。</view>
    <view class="search-row space"><input class="input" value="{{vehicleQuery}}" data-name="vehicleQuery" bindinput="input" confirm-type="search" bindconfirm="searchVehicle" placeholder="例如 BJ7000MBEVR2"/><button class="secondary search-button" loading="{{searching}}" bindtap="searchVehicle">检索</button></view>
    <view wx:if="{{selectedConfig}}" class="selected-config">
      <view class="row"><text class="tag">已选择</text><text class="link" bindtap="clearConfig">重新选择</text></view>
      <view class="subtitle space">{{selectedConfig.publicModel}}</view><view>{{selectedConfig.candidateLabel}}</view>
      <view class="muted small">电池包型号：{{selectedConfig.exactPackModel || '公开资料未披露'}}</view>
      <view class="muted small">材料置信度 {{selectedConfig.chemistryConfidence}} · 外形置信度 {{selectedConfig.formConfidence}}</view>
    </view>
    <block wx:for="{{vehicleResults}}" wx:key="publicModel" wx:for-item="model">
      <view class="vehicle-result"><view class="subtitle">{{model.publicModel}}</view><view class="muted small">{{model.commonName || '车型名称未补充'}} · {{model.vehicleMaker}}</view>
        <view wx:for="{{model.configurations}}" wx:key="id" wx:for-item="config" class="config-option {{selectedConfig.id === config.id ? 'active' : ''}}" data-id="{{config.id}}" bindtap="selectConfig">
          <view class="row"><text>{{config.candidateLabel}}</text><text>{{config.priceReady ? '选择' : '需铭牌'}}</text></view><view class="muted small">包型号：{{config.exactPackModel || '未公开'}} · {{config.id}}</view>
        </view>
      </view>
    </block>
  </view>
  <view wx:if="{{mode === 'manual'}}" class="card">
    <view class="subtitle">铭牌参数</view>
    <text class="label">生产企业（选填）</text><input class="input" value="{{producer}}" data-name="producer" bindinput="input" maxlength="80" placeholder="电池生产企业"/>
    <text class="label">电池化学体系</text><picker class="picker" range="{{chemistryLabels}}" value="{{chemistryIndex}}" data-name="chemistry" bindchange="change">{{chemistryLabels[chemistryIndex]}}</picker>
    <text class="label">单体外形 / 封装方式</text><picker class="picker" range="{{formLabels}}" value="{{formIndex}}" data-name="form" bindchange="change">{{formLabels[formIndex]}}</picker>
    <text class="label">电池包总重量（kg）</text><input class="input" type="digit" value="{{massKg}}" data-name="massKg" bindinput="input" placeholder="例如 420"/>
    <text class="label">电池包总电量（kWh）</text><input class="input" type="digit" value="{{energyKwh}}" data-name="energyKwh" bindinput="input" placeholder="例如 60.5"/>
    <view class="form-hint">这里的“容量”是整包总电量 kWh，不是单体 Ah。</view>
  </view>
  <view class="card">
    <view class="subtitle">车辆信息</view>
    <text class="label">车辆所在城市</text><input class="input" value="{{region}}" data-name="region" bindinput="input" maxlength="40" placeholder="例如 武汉"/>
    <text class="label">行驶里程（km）</text><input class="input" type="number" value="{{mileageKm}}" data-name="mileageKm" bindinput="input" placeholder="例如 50000"/>
    <view class="form-hint">城市和里程会写入报告，但不参与价格计算。</view>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button class="primary full" loading="{{busy}}" disabled="{{busy || (mode === 'vehicle' && !selectedConfig)}}" bindtap="submit">生成估价报告</button>
</view>
