page { background:#f3f7f4; color:#233b35; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif; font-size:28rpx; line-height:1.55; }
.page { box-sizing:border-box; min-height:100vh; padding:30rpx 28rpx 64rpx; }
.home-page { padding-top:22rpx; }
.page-heading { margin-bottom:24rpx; }
.title { color:#173d33; font-size:38rpx; font-weight:760; line-height:1.28; }
.subtitle { color:#233b35; font-size:30rpx; font-weight:700; }
.eyebrow { color:#0b7558; font-size:20rpx; font-weight:750; letter-spacing:3rpx; }
.muted { color:#71867e; }
.small { font-size:23rpx; }
.mono { font-family:monospace; word-break:break-all; }
.space { margin-top:20rpx; }
.full { width:100%; }
.row { display:flex; align-items:center; justify-content:space-between; gap:18rpx; }
.grid { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; }
.card { box-sizing:border-box; margin-bottom:24rpx; padding:30rpx; border:1rpx solid #dfe9e3; border-radius:28rpx; background:#fff; box-shadow:0 8rpx 32rpx rgba(23,76,56,.06); }
.quick-card { border-top:6rpx solid #0b7558; }
.brand-lockup { display:flex; align-items:center; gap:16rpx; margin-bottom:20rpx; }
.brand-lockup image { width:72rpx; height:72rpx; }
.brand-name { color:#173d33; font-size:38rpx; font-weight:800; line-height:1; }
.banner-swiper { height:360rpx; margin-bottom:26rpx; overflow:hidden; border-radius:32rpx; background:#0b7558; box-shadow:0 18rpx 42rpx rgba(11,117,88,.16); }
.banner-slide { position:relative; width:100%; height:100%; }
.banner-image { width:100%; height:100%; }
.banner-copy { position:absolute; top:52rpx; right:250rpx; left:42rpx; color:#fff; }
.banner-eyebrow { color:#cbe9dc; font-size:18rpx; letter-spacing:3rpx; }
.banner-title { margin-top:20rpx; font-size:42rpx; font-weight:780; white-space:nowrap; }
.banner-subtitle { margin-top:12rpx; color:#e5f7ef; font-size:24rpx; }
.banner-cta { width:184rpx; margin-top:34rpx; padding:12rpx 20rpx; border-radius:999rpx; background:rgba(255,255,255,.96); color:#0b7558; font-size:22rpx; font-weight:700; text-align:center; }
.tile-grid { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; margin-bottom:24rpx; }
.tile { min-height:150rpx; padding:28rpx; border-radius:26rpx; background:#e4f0e9; }
.tile.warm { background:#f3ecdd; }
.tile-glyph { color:#0b7558; font-size:44rpx; line-height:1; }
.step-row { display:flex; gap:22rpx; padding:24rpx 0; border-bottom:1rpx solid #edf2ef; }
.step-row:last-child { border-bottom:0; }
.step-number { color:#0b7558; font-size:34rpx; font-weight:700; }
.primary,.secondary,.ghost,.danger { box-sizing:border-box; min-height:84rpx; padding:18rpx 24rpx; border-radius:18rpx; font-size:28rpx; font-weight:700; line-height:1.4; }
.primary { background:#0b7558; color:#fff; }
.secondary,.ghost { border:1rpx solid #bcd7ca; background:#fff; color:#0b7558; }
.danger { border:1rpx solid #d6a49a; background:#fff; color:#a94d3a; }
.label { display:block; margin:24rpx 0 10rpx; color:#3b5a50; font-size:25rpx; }
.input,.picker,textarea { box-sizing:border-box; width:100%; min-height:86rpx; padding:20rpx 22rpx; border:1rpx solid #d7e4dc; border-radius:18rpx; background:#fbfdfb; color:#233b35; }
textarea { height:180rpx; }
.form-hint { margin-top:12rpx; color:#71867e; font-size:22rpx; line-height:1.7; }
.mode-switch { display:grid; grid-template-columns:1fr 1fr; margin-bottom:24rpx; padding:7rpx; border-radius:20rpx; background:#e8efeb; }
.mode-button { padding:18rpx 8rpx; border-radius:16rpx; color:#71867e; text-align:center; }
.mode-button.active { background:#fff; color:#0b7558; font-weight:700; box-shadow:0 5rpx 16rpx rgba(23,76,56,.08); }
.search-row { display:flex; align-items:stretch; gap:14rpx; width:100%; }
.search-row .input { flex:1 1 auto; width:auto; min-width:0; }
.search-button { flex:0 0 144rpx; width:144rpx; min-width:0; min-height:86rpx; margin:0; padding-right:12rpx; padding-left:12rpx; }
.vehicle-result { padding:24rpx 0; border-top:1rpx solid #e7eee9; }
.config-option { margin-top:14rpx; padding:20rpx; border:1rpx solid #dfe9e3; border-radius:18rpx; background:#fbfdfb; }
.config-option.active { border-color:#0b7558; background:#e8f5ef; }
.selected-config,.source-box,.formula { margin-top:20rpx; padding:22rpx; border-left:6rpx solid #0b7558; border-radius:16rpx; background:#eff7f2; }
.tag { display:inline-flex; padding:6rpx 16rpx; border:1rpx solid #cfe8dc; border-radius:999rpx; background:#e8f5ef; color:#0b7558; font-size:22rpx; }
.link { color:#0b7558; }
.notice { margin:16rpx 0; padding:20rpx 22rpx; border-radius:18rpx; background:#fff5dd; color:#805f2c; font-size:23rpx; line-height:1.7; }
.error { margin:18rpx 0; padding:22rpx; border-radius:18rpx; background:#ffede9; color:#a13626; word-break:break-all; }
.empty { padding:52rpx 24rpx; color:#71867e; text-align:center; }
.item { padding:22rpx 0; border-bottom:1rpx solid #edf1ed; }
.item:last-child { border-bottom:0; }
.value { color:#173d33; font-weight:700; text-align:right; }
.price { margin:18rpx 0; color:#0b7558; font-size:48rpx; font-weight:780; line-height:1.25; }
.bottom-note { margin-top:30rpx; color:#71867e; font-size:22rpx; text-align:center; }
.report-page { padding:0; }
.report-hero { position:relative; overflow:hidden; padding:42rpx 34rpx 80rpx; background:linear-gradient(145deg,#087052,#11936c); color:#fff; }
.report-hero .eyebrow,.report-hero .small { color:#cbe9dc; }
.report-title { margin:10rpx 0 18rpx; font-size:38rpx; font-weight:760; }
.report-body { position:relative; margin-top:-48rpx; padding:0 28rpx 60rpx; }
.valuation-card { text-align:center; }
.metal-item { padding:24rpx 0; border-bottom:1rpx solid #edf1ed; }
.metal-item:last-child { padding-bottom:0; border-bottom:0; }
.metal-meta { display:flex; flex-direction:column; gap:4rpx; margin-top:8rpx; color:#71867e; font-size:22rpx; }
.bullet { margin:16rpx 0; }
.right { text-align:right; }
.radio-row { display:flex; flex-wrap:wrap; gap:14rpx; }
.pill { padding:14rpx 22rpx; border:1rpx solid #d9e4dc; border-radius:16rpx; background:#fff; }
.pill.active { border-color:#0b7558; background:#0b7558; color:#fff; }
.check { display:flex; align-items:center; gap:12rpx; margin:20rpx 0; font-size:25rpx; }
