page{background:#f2f5f3;color:#20372f;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6}view,text,input,textarea,button{box-sizing:border-box}.page{padding:28rpx 28rpx 70rpx}.card{background:#fff;border:1rpx solid #e2e9e5;border-radius:24rpx;padding:30rpx;margin-bottom:24rpx}.hero{background:#123b33;color:#fff;border-radius:28rpx;padding:38rpx 32rpx;margin-bottom:26rpx}.eyebrow{font-size:22rpx;letter-spacing:5rpx;opacity:.72}.hero-title{font-size:48rpx;font-weight:650;line-height:1.35;margin:18rpx 0}.hero-desc{color:#ceddd5;font-size:26rpx}.title{font-size:34rpx;font-weight:650;margin-bottom:18rpx}.subtitle{font-size:28rpx;font-weight:600}.muted{color:#718078;font-size:24rpx}.small{font-size:23rpx}.row{display:flex;justify-content:space-between;align-items:center;gap:16rpx}.wrap{flex-wrap:wrap}.grow{flex:1}.space{margin-top:24rpx}.label{display:block;margin:24rpx 0 12rpx;font-size:26rpx;font-weight:550}.input,.picker,textarea{width:100%;background:#f5f8f6;border:1rpx solid #dce5df;border-radius:14rpx;padding:20rpx 22rpx;min-height:86rpx;font-size:28rpx;color:#20372f}.input{height:88rpx}textarea{height:180rpx}.picker:after{content:'⌄';float:right;color:#708279}button{border-radius:14rpx;font-size:28rpx;margin:0;line-height:2.7;font-weight:550}button::after{border:none}.primary{background:#146a50;color:#fff}.secondary{background:#eaf2ed;color:#155840}.ghost{background:#fff;color:#376250;border:1rpx solid #dce5df}.danger{color:#a33629;background:#fff0ec}.full{width:100%}.grid{display:flex;gap:20rpx}.grid>view,.grid>button{flex:1;min-width:0}.tag{display:inline-block;background:#e9f3ec;color:#17634a;border-radius:8rpx;font-size:22rpx;padding:5rpx 12rpx}.notice{background:#fff5de;color:#795c21;padding:22rpx;border-radius:14rpx;font-size:25rpx;margin:20rpx 0}.error{background:#ffede9;color:#a13626;padding:24rpx;border-radius:14rpx;margin:20rpx 0;word-break:break-all}.empty{text-align:center;padding:52rpx 28rpx;color:#697a70}.price{font-size:48rpx;font-weight:650;color:#146a50;line-height:1.3;margin:16rpx 0}.divider{border-top:1rpx solid #e7ede9;margin:22rpx 0}.item{padding:22rpx 0;border-bottom:1rpx solid #edf1ed}.value{font-weight:600;text-align:right}.link{color:#17664e;text-decoration:underline}.check{font-size:25rpx;display:flex;align-items:center;gap:12rpx;margin:20rpx 0}.bullet{margin:14rpx 0}.bottom-note{text-align:center;margin-top:28rpx;color:#718078;font-size:22rpx}.mono{font-family:monospace;word-break:break-all}.radio-row{display:flex;flex-wrap:wrap;gap:14rpx}.pill{padding:14rpx 22rpx;border:1rpx solid #d9e4dc;border-radius:12rpx;background:#fff}.pill.active{color:#146a50;border-color:#146a50;background:#eaf4ed}.right{text-align:right}
