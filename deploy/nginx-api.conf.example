# Include in nginx's http {} block. Replace the domain and certificate paths.
# Existing H5 server on :8081 can remain as-is.
limit_req_zone $binary_remote_addr zone=xundian_api:10m rate=5r/s;
server {
    listen 443 ssl;
    server_name api.example.com;
    ssl_certificate C:/nginx/cert/fullchain.pem;
    ssl_certificate_key C:/nginx/cert/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    location = /api/auth/dev { return 404; }
    location /api/ {
        limit_req zone=xundian_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }
    location = /health { proxy_pass http://127.0.0.1:8082; }
    location / { return 404; }
}
